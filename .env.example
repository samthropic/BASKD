# Copy to `.env` and fill in the values. `.env` is git-ignored.
# Every setting is also readable from the environment (same names).

# Which calendar provider backs the API: "google" (real) or "memory" (fake, nothing persisted).
BASKD_PROVIDER=google

# Google Calendar (required when BASKD_PROVIDER=google). See docs/HUMAN_STEPS.md.
# Path to the service-account key file downloaded from Google Cloud ...
BASKD_GOOGLE_CREDENTIALS_FILE=secrets/service-account.json
# ... or, alternatively (useful in CI), the key file's JSON contents inline:
# BASKD_GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# ID of the shared test calendar, e.g. abc123@group.calendar.google.com
BASKD_GOOGLE_CALENDAR_ID=

# Per-call timeout for provider requests, in seconds.
BASKD_GOOGLE_TIMEOUT_SECONDS=10

# Logging: DEBUG, INFO, WARNING, ERROR
BASKD_LOG_LEVEL=INFO
