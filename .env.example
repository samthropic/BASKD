# Copy to `.env` and fill in the values. `.env` is git-ignored.
# Every setting is also readable from the environment (same names).

# Which calendar provider backs the API: "google" (real) or "memory" (fake, nothing persisted).
BASKD_PROVIDER=google

# Google Calendar (required when BASKD_PROVIDER=google). See docs/HUMAN_STEPS.md.
# Path to the service-account key file downloaded from Google Cloud ...
BASKD_GOOGLE_CREDENTIALS_FILE=secrets/service-account.json
# ... or, alternatively (useful in CI), the key file's JSON contents inline:
# BASKD_GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# ID of the shared test calendar, e.g. abc123@group.calendar.google.com
BASKD_GOOGLE_CALENDAR_ID=

# Per-call timeout for provider requests, in seconds.
BASKD_GOOGLE_TIMEOUT_SECONDS=10

# Logging: DEBUG, INFO, WARNING, ERROR
BASKD_LOG_LEVEL=INFO

# Log line format: "text" (local) or "json" (Cloud Logging's structured format; Cloud Run).
BASKD_LOG_FORMAT=text

# Google Cloud project that receives traces (Cloud Trace). Leave unset locally: spans are
# still made, so log lines carry a trace id, but nothing is exported.
# BASKD_GCP_PROJECT=baskd-calendar

# HW3 workflow: whose implementation backs each of the other two verticals.
# Storage: "team3" or "team1" (both Dropbox), "memory", or "failing" (every call fails).
BASKD_WORKFLOW_STORAGE=memory
# Issue tracker: "team4" (Trello), "memory", or "failing".
BASKD_WORKFLOW_ISSUES=memory

# The other teams' packages read these themselves from the process environment (not from
# this file unless you run `uv run --env-file .env ...`). Use the team's test accounts only.
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_LIST_ID=
