# Copy to prod.tfvars (or staging.tfvars) and fill in. *.tfvars files are git-ignored.
# Nothing in here is a secret: the Calendar key goes into Secret Manager, never into a variable.

project_id  = "baskd-calendar"
region      = "us-east1"
environment = "prod"
calendar_id = "<the value of BASKD_GOOGLE_CALENDAR_ID in your .env>"

# Leave commented out on the first apply. After pushing an image (README step 3):
# image = "us-east1-docker.pkg.dev/baskd-calendar/baskd/baskd@sha256:<digest>"

# Who may call the service, e.g. teammates and the TAs (docs/DEPLOYMENT.md §4 has the choice):
# invokers = ["user:someone@nyu.edu"]
# invokers = ["domain:nyu.edu"]       # any NYU Google account

# HW3 workflow: whose implementation backs storage and the issue tracker. Before choosing
# team3/team1 or team4, put the credentials in Secret Manager (scripts/add_workflow_secrets.sh),
# or the new revision fails to start. Changing these is the implementation swap.
# workflow_storage = "team3"          # team3 | team1 | memory | failing
# workflow_issues  = "team4"          # team4 | memory | failing
# trello_list_id   = "<24-character id of the test board's list>"
